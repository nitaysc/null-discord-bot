# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Bot Activity Status text (defaults to "null • /play")
BOT_STATUS=null • /play

# Low-RAM Node.js Optimization for 256MB Hosting
NODE_OPTIONS=--expose-gc --max-old-space-size=160 --optimize-for-size

# AI Provider Keys (The bot rotates and automatically cascades/falls back between configured providers)
# 1. Groq (14,400 messages/day - Blazing fast): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# 2. OpenRouter (50 messages/day free): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# 3. Google Gemini (1,500 messages/day): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: YouTube Cookie (paste cookie to completely bypass YouTube 429 rate-limits on shared hosting)
# YOUTUBE_COOKIE=
