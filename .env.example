# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Bot Activity Status text (defaults to "null • /play")
BOT_STATUS=null • /play

# Low-RAM Node.js Optimization for 256MB Hosting
NODE_OPTIONS=--expose-gc --max-old-space-size=160 --optimize-for-size

# AI Provider Keys (The bot rotates and automatically cascades/falls back between configured providers)
# 1. Groq (14,400 messages/day - Blazing fast): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# 2. OpenRouter (50 messages/day free): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# 3. Google Gemini (1,500 messages/day): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: YouTube Cookie (paste cookie to completely bypass YouTube 429 rate-limits on shared hosting)
# YOUTUBE_COOKIE=

# ==========================================
# 🎨 AI IMAGE GENERATION PROVIDERS
# (The bot auto-cascades between active keys for /imagine and @null draw requests)
# ==========================================
# 1. Stability AI (SD 3.5 Large / SD Core - 25 free credits upon signup): https://platform.stability.ai
STABILITY_API_KEY=your_stability_key_here

# 2. AI Horde (100% Free crowdsourced GPU network - Register free key or leave blank): https://aihorde.net/register
AI_HORDE_API_KEY=your_aihorde_key_here

# 3. ClipDrop (By Stability AI - Fast SDXL Turbo): https://clipdrop.co/apis
CLIPDROP_API_KEY=your_clipdrop_key_here

# 4. Hugging Face (FLUX.1-schnell & SDXL - Free user access token): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hf_token_here

# 5. Picsart GenAI (Artistic/Stylized text-to-image): https://picsart.io
PICSART_API_KEY=your_picsart_key_here
